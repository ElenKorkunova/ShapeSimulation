# ==========================================
# Настройки IDE (Qt Creator, VS Code и др.)
# ==========================================
.qtcreator/
*.user
*.user.*
.cmake/
.qmake.stash

# Настройки других популярных редакторов (на случай, если коллеги работают в них)
.vscode/
.idea/
*.suo
*.userosscache
*.sln.docstates

# ==========================================
# Директории сборки и компиляции (Shadow Builds)
# ==========================================
build/
build*/
build-*/
CMakeLists.txt.user

# ==========================================
# Артефакты компиляции C++
# ==========================================
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe

# ==========================================
# Специфичные файлы QtQuick / QML
# ==========================================
# Кэш компилятора QML (ускоряет запуск, генерируется автоматически)
*.qmlc
*.jsc

# Временные файлы компиляции QML-кэша
qmlcache_clean.cmake
*.qmlcache

# Файлы локализации (если вы компилируете .ts в .qm, бинарники .qm в репо не нужны)
*.qm

# ==========================================
# Системный мусор
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
*.autosave
